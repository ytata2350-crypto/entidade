# Projeto independente: não use o .env nem o banco do overlay-saas.
PORT=3210
HOST=127.0.0.1
DATABASE_PATH=./data/limiar.sqlite
# Nome do canal, sem #. Vazio deixa a página na demonstração.
TWITCH_CHANNEL=
# Gere uma chave longa e aleatória. A integração fica desativada sem esta chave.
BOT_API_KEY=
COMMAND_PREFIX=!
EXPLORE_COOLDOWN_SECONDS=600
DEMO_EXPLORE_COOLDOWN_SECONDS=30
# Só ligue se preferir um bot independente ao adaptador do bot existente.
TWITCH_BOT_ENABLED=0
TWITCH_BOT_USERNAME=
TWITCH_BOT_OAUTH=
